<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GPS Trip Recorder Bridge"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Perangkat Bluetooth GPS:"
        android:textColor="#555555"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinnerDevices"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hubungkan"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Putuskan"
            android:enabled="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Terputus"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Latitude: -\nLongitude: -"
        android:textSize="16sp"
        android:textColor="#1976D2"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvExtra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Satelit: 0 | Ketinggian: 0 m | Kecepatan: 0 km/h"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvRawNmea"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#212121"
        android:textColor="#00E676"
        android:padding="10dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:text="Log NMEA akan muncul di sini..."
        android:scrollbars="vertical" />
</LinearLayout>
